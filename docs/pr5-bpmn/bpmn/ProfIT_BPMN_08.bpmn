      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E_A1_di" bpmnElement="E_A1">
        <dc:Bounds x="522" y="267" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="491" y="307" width="98" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ST_A2_di" bpmnElement="ST_A2">
        <dc:Bounds x="637" y="95" width="156" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ST_A3_di" bpmnElement="ST_A3">
        <dc:Bounds x="823" y="95" width="133" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E_A2_di" bpmnElement="E_A2">
        <dc:Bounds x="1047" y="117" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="981" y="157" width="168" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_0_di" bpmnElement="flow_0">
        <di:waypoint x="208" y="135" />
        <di:waypoint x="315" y="135" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_1_di" bpmnElement="flow_1">
        <di:waypoint x="415" y="135" />
        <di:waypoint x="515" y="135" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_2_di" bpmnElement="flow_2">
        <di:waypoint x="540" y="160" />
        <di:waypoint x="540" y="267" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="514" y="208" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_3_di" bpmnElement="flow_3">
        <di:waypoint x="565" y="135" />
        <di:waypoint x="637" y="135" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="561" y="117" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_4_di" bpmnElement="flow_4">
        <di:waypoint x="793" y="135" />
        <di:waypoint x="823" y="135" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_5_di" bpmnElement="flow_5">
        <di:waypoint x="956" y="135" />
        <di:waypoint x="1047" y="135" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="TS_di" bpmnElement="TS" isHorizontal="true">
        <dc:Bounds x="60" y="470" width="1122" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="msg_0_di" bpmnElement="msg_0">
        <di:waypoint x="190" y="470" />
        <di:waypoint x="190" y="153" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="157" y="307" width="95" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
