    <bpmn:sequenceFlow id="flow_16" sourceRef="S_CAT" targetRef="CA04" />
    <bpmn:sequenceFlow id="flow_17" sourceRef="CA04" targetRef="E_CAT" />
    <bpmn:startEvent id="S_TEST" name="Тест подготовлен к публикации">
      <bpmn:outgoing>flow_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="med_S_TEST" />
    </bpmn:startEvent>
    <bpmn:endEvent id="E_ADM" name="Доступ настроен">
      <bpmn:incoming>flow_15</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
