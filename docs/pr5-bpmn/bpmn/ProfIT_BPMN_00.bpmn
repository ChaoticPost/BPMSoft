<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ProfIT_BPMN_00" targetNamespace="http://bpmn.io/schema/bpmn" exporter="ProfIT BPMN build" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_ProfIT_BPMN_00">
    <bpmn:participant id="Pool_ProfIT_BPMN_00" name="ProfIT — сквозной контур процессов (BPMN-00)" processRef="Process_ProfIT_BPMN_00" />
    <bpmn:participant id="USR" name="Публичный пользователь" />
    <bpmn:participant id="OWN" name="Владелец ProfIT" />
    <bpmn:participant id="TS" name="Торговый контур" />
    <bpmn:participant id="PROV" name="Почтовый провайдер" />
    <bpmn:participant id="EMP" name="Сотрудник ProfIT" />
    <bpmn:messageFlow id="msg_0" name="Участие в турнире" sourceRef="USR" targetRef="CA01" />
    <bpmn:messageFlow id="msg_1" name="Прохождение теста" sourceRef="USR" targetRef="CA03" />
    <bpmn:messageFlow id="msg_2" name="Письмо с промокодом" sourceRef="CA05" targetRef="PROV" />
    <bpmn:messageFlow id="msg_3" name="Статусы доставки" sourceRef="PROV" targetRef="CA05" />
    <bpmn:messageFlow id="msg_4" name="Проверка / покупка" sourceRef="TS" targetRef="CA06" />
    <bpmn:messageFlow id="msg_5" name="Пакет продаж" sourceRef="TS" targetRef="CA08" />
    <bpmn:messageFlow id="msg_6" name="Запрос отчётов" sourceRef="OWN" targetRef="CA10" />
    <bpmn:messageFlow id="msg_7" name="Ручная отмена" sourceRef="OWN" targetRef="CA07" />
    <bpmn:messageFlow id="msg_8" name="Запрос администрирования" sourceRef="OWN" targetRef="S_ADM" />
    <bpmn:messageFlow id="msg_9" name="Запуск турнира" sourceRef="EMP" targetRef="S_GAME" />
    <bpmn:messageFlow id="msg_10" name="Ведение каталога" sourceRef="EMP" targetRef="S_CAT" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ProfIT_BPMN_00" name="ProfIT — сквозной контур процессов (BPMN-00)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ProfIT_BPMN_00">
      <bpmn:lane id="lane_core" name="Основной контур MVP">
        <bpmn:flowNodeRef>S_GAME</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CA01</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_GAME</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CA02</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CA03</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_TEST</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_B</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CA05</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CA06</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CA08</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CA10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_FIN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_TEST</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_sup" name="Сопровождение и контроль">
        <bpmn:flowNodeRef>S_SUP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CA07</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_SUP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_ADM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CA09</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_CAT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CA04</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_CAT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_ADM</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S_GAME" name="Турнир инициирован">
      <bpmn:outgoing>flow_0</bpmn:outgoing>
      <bpmn:messageEventDefinition id="med_S_GAME" />
    </bpmn:startEvent>
    <bpmn:callActivity id="CA01" name="Проведение турнира (BPMN-01)" calledElement="Process_ProfIT_BPMN_01">
      <bpmn:incoming>flow_0</bpmn:incoming>
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:intermediateThrowEvent id="T_GAME" name="Основание GAME → BPMN-05">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="med_T_GAME" />
    </bpmn:intermediateThrowEvent>
    <bpmn:callActivity id="CA02" name="Версия теста (BPMN-02)" calledElement="Process_ProfIT_BPMN_02">
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="CA03" name="Прохождение теста (BPMN-03)" calledElement="Process_ProfIT_BPMN_03">
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:intermediateThrowEvent id="T_TEST" name="Основание TEST → BPMN-05">
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
      <bpmn:messageEventDefinition id="med_T_TEST" />
    </bpmn:intermediateThrowEvent>
    <bpmn:exclusiveGateway id="J_B" name="">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:outgoing>flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="CA05" name="Промокод и почтовые события (BPMN-05)" calledElement="Process_ProfIT_BPMN_05">
      <bpmn:incoming>flow_7</bpmn:incoming>
      <bpmn:outgoing>flow_8</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="CA06" name="Проверка и активация (BPMN-06)" calledElement="Process_ProfIT_BPMN_06">
      <bpmn:incoming>flow_8</bpmn:incoming>
      <bpmn:outgoing>flow_9</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="CA08" name="Импорт продаж (BPMN-08)" calledElement="Process_ProfIT_BPMN_08">
      <bpmn:incoming>flow_9</bpmn:incoming>
      <bpmn:outgoing>flow_10</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="CA10" name="Отчётность R-1–R-4 (BPMN-10)" calledElement="Process_ProfIT_BPMN_10">
      <bpmn:incoming>flow_10</bpmn:incoming>
      <bpmn:outgoing>flow_11</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="E_FIN" name="Контур завершён">
      <bpmn:incoming>flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="S_SUP" name="Плановая проверка сроков">
      <bpmn:outgoing>flow_12</bpmn:outgoing>
      <bpmn:timerEventDefinition id="ted_S_SUP" />
    </bpmn:startEvent>
    <bpmn:callActivity id="CA07" name="Контроль сроков и аннуляция (BPMN-07)" calledElement="Process_ProfIT_BPMN_07">
      <bpmn:incoming>flow_12</bpmn:incoming>
      <bpmn:outgoing>flow_13</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="E_SUP" name="Коды актуальны или аннулированы">
      <bpmn:incoming>flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="S_ADM" name="Запрос администрирования">
      <bpmn:outgoing>flow_14</bpmn:outgoing>
      <bpmn:messageEventDefinition id="med_S_ADM" />
    </bpmn:startEvent>
    <bpmn:callActivity id="CA09" name="Роли и сеансы (BPMN-09)" calledElement="Process_ProfIT_BPMN_09">
      <bpmn:incoming>flow_14</bpmn:incoming>
      <bpmn:outgoing>flow_15</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:startEvent id="S_CAT" name="Запрос на создание или изменение карточки">
      <bpmn:outgoing>flow_16</bpmn:outgoing>
      <bpmn:messageEventDefinition id="med_S_CAT" />
    </bpmn:startEvent>
    <bpmn:callActivity id="CA04" name="Каталог товаров (BPMN-04)" calledElement="Process_ProfIT_BPMN_04">
      <bpmn:incoming>flow_16</bpmn:incoming>
      <bpmn:outgoing>flow_17</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="E_CAT" name="Каталог опубликован">
      <bpmn:incoming>flow_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_0" sourceRef="S_GAME" targetRef="CA01" />
    <bpmn:sequenceFlow id="flow_1" sourceRef="CA01" targetRef="T_GAME" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="T_GAME" targetRef="J_B" />
