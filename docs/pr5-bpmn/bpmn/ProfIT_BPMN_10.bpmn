<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ProfIT_BPMN_10" targetNamespace="http://bpmn.io/schema/bpmn" exporter="ProfIT BPMN build" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_ProfIT_BPMN_10">
    <bpmn:participant id="Pool_ProfIT_BPMN_10" name="ProfIT — отчётность владельца R-1–R-4 (BPMN-10)" processRef="Process_ProfIT_BPMN_10" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ProfIT_BPMN_10" name="ProfIT — отчётность владельца R-1–R-4 (BPMN-10)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ProfIT_BPMN_10">
      <bpmn:lane id="lane_own" name="Владелец ProfIT">
        <bpmn:flowNodeRef>S_B</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_B2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_sys" name="Платформа BPMSoft">
        <bpmn:flowNodeRef>ST_B1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_B</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_B1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_B2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_B3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_B2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S_B" name="Владелец открыл Insight">
      <bpmn:outgoing>flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T_B2" name="Задать параметры отчёта (период, когорта)">
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ST_B1" name="Проверить право REPORT_VIEW">
      <bpmn:incoming>flow_0</bpmn:incoming>
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_B" name="Просмотр разрешён?">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_B1" name="Отказано в доступе">
      <bpmn:incoming>flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ST_B2" name="Рассчитать показатели R-1–R-4 по когортам sentAt">
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ST_B3" name="Отобразить отчёты в веб-клиенте">
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E_B2" name="Отчётность предоставлена">
      <bpmn:incoming>flow_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_0" sourceRef="S_B" targetRef="ST_B1" />
    <bpmn:sequenceFlow id="flow_1" sourceRef="ST_B1" targetRef="G_B" />
    <bpmn:sequenceFlow id="flow_2" name="Нет" sourceRef="G_B" targetRef="E_B1" />
    <bpmn:sequenceFlow id="flow_3" name="Да" sourceRef="G_B" targetRef="T_B2" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="T_B2" targetRef="ST_B2" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="ST_B2" targetRef="ST_B3" />
    <bpmn:sequenceFlow id="flow_6" sourceRef="ST_B3" targetRef="E_B2" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDI_ProfIT_BPMN_10">
    <bpmndi:BPMNPlane id="BPMNPlane_ProfIT_BPMN_10" bpmnElement="Collab_ProfIT_BPMN_10">
      <bpmndi:BPMNShape id="Pool_ProfIT_BPMN_10_di" bpmnElement="Pool_ProfIT_BPMN_10" isHorizontal="true">
        <dc:Bounds x="60" y="60" width="1472" height="300" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_sys_di" bpmnElement="lane_sys" isHorizontal="true">
        <dc:Bounds x="90" y="210" width="1442" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_own_di" bpmnElement="lane_own" isHorizontal="true">
        <dc:Bounds x="90" y="60" width="1442" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_B_di" bpmnElement="S_B">
        <dc:Bounds x="172" y="117" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="136" y="93" width="126" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_B2_di" bpmnElement="T_B2">
        <dc:Bounds x="840" y="95" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ST_B1_di" bpmnElement="ST_B1">
        <dc:Bounds x="310" y="245" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_B_di" bpmnElement="G_B" isMarkerVisible="true">
        <dc:Bounds x="515" y="260" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="511" y="319.5" width="57" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E_B1_di" bpmnElement="E_B1">
        <dc:Bounds x="697" y="267" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="652" y="307" width="126" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ST_B2_di" bpmnElement="ST_B2">
        <dc:Bounds x="1014" y="245" width="102" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ST_B3_di" bpmnElement="ST_B3">
        <dc:Bounds x="1185" y="245" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E_B2_di" bpmnElement="E_B2">
        <dc:Bounds x="1397" y="267" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1331" y="307" width="168" height="30" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_0_di" bpmnElement="flow_0">
        <di:waypoint x="190" y="153" />
        <di:waypoint x="190" y="285" />
        <di:waypoint x="310" y="285" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_1_di" bpmnElement="flow_1">
        <di:waypoint x="420" y="285" />
        <di:waypoint x="515" y="285" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_2_di" bpmnElement="flow_2">
        <di:waypoint x="565" y="285" />
        <di:waypoint x="697" y="285" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="591" y="267" width="80" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_3_di" bpmnElement="flow_3">
        <di:waypoint x="540" y="260" />
        <di:waypoint x="540" y="135" />
        <di:waypoint x="840" y="135" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="522" y="191" width="14" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_4_di" bpmnElement="flow_4">
        <di:waypoint x="940" y="135" />
        <di:waypoint x="970" y="135" />
        <di:waypoint x="970" y="285" />
        <di:waypoint x="1014" y="285" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_5_di" bpmnElement="flow_5">
        <di:waypoint x="1116" y="285" />
        <di:waypoint x="1185" y="285" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_6_di" bpmnElement="flow_6">
        <di:waypoint x="1295" y="285" />
        <di:waypoint x="1397" y="285" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
