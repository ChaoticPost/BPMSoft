<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ProfIT_BPMN_04" targetNamespace="http://bpmn.io/schema/bpmn" exporter="ProfIT BPMN build" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_ProfIT_BPMN_04">
    <bpmn:participant id="Pool_ProfIT_BPMN_04" name="ProfIT — ведение и публикация каталога товаров (BPMN-04)" processRef="Process_ProfIT_BPMN_04"/>
    <bpmn:participant id="PUB" name="Публичный пользователь (Web/Mobile)"/>
    <bpmn:messageFlow id="msg_0" name="Опубликованные данные товара" sourceRef="SND1" targetRef="PUB"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_ProfIT_BPMN_04" name="ProfIT — ведение и публикация каталога товаров (BPMN-04)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ProfIT_BPMN_04">
      <bpmn:lane id="lane_emp" name="Сотрудник ProfIT">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_sys" name="Платформа BPMSoft">
        <bpmn:flowNodeRef>SP_FILL</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SND1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Запрос на создание или изменение карточки">
      <bpmn:outgoing>flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="E2" name="Отказано в доступе">
      <bpmn:incoming>flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T1" name="Выбрать товарную группу">
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:subProcess id="SP_FILL" name="Заполнение и проверка карточки">
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
      <bpmn:startEvent id="iS" name="Карточка открыта">
        <bpmn:outgoing>SP_FILL_if_0</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="iJ1" name="Слияние">
        <bpmn:incoming>SP_FILL_if_0</bpmn:incoming>
        <bpmn:incoming>SP_FILL_if_6</bpmn:incoming>
        <bpmn:outgoing>SP_FILL_if_1</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="iT2" name="Заполнить название, описание, цену, публикацию">
        <bpmn:incoming>SP_FILL_if_1</bpmn:incoming>
        <bpmn:outgoing>SP_FILL_if_2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="iST" name="Проверить поля, цену и группу">
        <bpmn:incoming>SP_FILL_if_2</bpmn:incoming>
        <bpmn:outgoing>SP_FILL_if_3</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="iG" name="Карточка корректна?">
        <bpmn:incoming>SP_FILL_if_3</bpmn:incoming>
        <bpmn:outgoing>SP_FILL_if_4</bpmn:outgoing>
        <bpmn:outgoing>SP_FILL_if_5</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="iT3" name="Исправить карточку">
        <bpmn:incoming>SP_FILL_if_5</bpmn:incoming>
        <bpmn:outgoing>SP_FILL_if_6</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="iE" name="Карточка проверена">
        <bpmn:incoming>SP_FILL_if_4</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SP_FILL_if_0" sourceRef="iS" targetRef="iJ1"/>
      <bpmn:sequenceFlow id="SP_FILL_if_1" sourceRef="iJ1" targetRef="iT2"/>
      <bpmn:sequenceFlow id="SP_FILL_if_2" sourceRef="iT2" targetRef="iST"/>
      <bpmn:sequenceFlow id="SP_FILL_if_3" sourceRef="iST" targetRef="iG"/>
      <bpmn:sequenceFlow id="SP_FILL_if_4" name="Да" sourceRef="iG" targetRef="iE"/>
      <bpmn:sequenceFlow id="SP_FILL_if_5" name="Нет" sourceRef="iG" targetRef="iT3"/>
      <bpmn:sequenceFlow id="SP_FILL_if_6" sourceRef="iT3" targetRef="iJ1"/>
    </bpmn:subProcess>
    <bpmn:serviceTask id="ST0" name="Проверить право CATALOG_MANAGE">
      <bpmn:incoming>flow_0</bpmn:incoming>
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G1" name="Право есть?">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G3" name="Признак публикации?">
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
      <bpmn:outgoing>flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ST2" name="Установить published=true и сохранить">
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:outgoing>flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ST3" name="Сохранить скрытой (без публикации)">
      <bpmn:incoming>flow_7</bpmn:incoming>
      <bpmn:outgoing>flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="SND1" name="Предоставить карточку публичному каталогу">
      <bpmn:incoming>flow_8</bpmn:incoming>
      <bpmn:outgoing>flow_10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="J3" name="Слияние">
      <bpmn:incoming>flow_9</bpmn:incoming>
      <bpmn:incoming>flow_10</bpmn:incoming>
      <bpmn:outgoing>flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E1" name="Карточка сохранена">
      <bpmn:incoming>flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_0" sourceRef="S1" targetRef="ST0"/>
    <bpmn:sequenceFlow id="flow_1" sourceRef="ST0" targetRef="G1"/>
    <bpmn:sequenceFlow id="flow_2" name="Нет" sourceRef="G1" targetRef="E2"/>
    <bpmn:sequenceFlow id="flow_3" name="Да" sourceRef="G1" targetRef="T1"/>
    <bpmn:sequenceFlow id="flow_4" sourceRef="T1" targetRef="SP_FILL"/>
    <bpmn:sequenceFlow id="flow_5" sourceRef="SP_FILL" targetRef="G3"/>
    <bpmn:sequenceFlow id="flow_6" name="Да" sourceRef="G3" targetRef="ST2"/>
    <bpmn:sequenceFlow id="flow_7" name="Нет" sourceRef="G3" targetRef="ST3"/>
    <bpmn:sequenceFlow id="flow_8" sourceRef="ST2" targetRef="SND1"/>
    <bpmn:sequenceFlow id="flow_9" sourceRef="ST3" targetRef="J3"/>
    <bpmn:sequenceFlow id="flow_10" sourceRef="SND1" targetRef="J3"/>
    <bpmn:sequenceFlow id="flow_11" sourceRef="J3" targetRef="E1"/>
  </bpmn:process>
