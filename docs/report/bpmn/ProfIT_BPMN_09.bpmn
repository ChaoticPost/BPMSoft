<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ProfIT_BPMN_09" targetNamespace="http://bpmn.io/schema/bpmn" exporter="ProfIT BPMN build" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_ProfIT_BPMN_09">
    <bpmn:participant id="Pool_ProfIT_BPMN_09" name="ProfIT — управление ролями, разрешениями и сеансами (BPMN-09)" processRef="Process_ProfIT_BPMN_09" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ProfIT_BPMN_09" name="ProfIT — управление ролями, разрешениями и сеансами (BPMN-09)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ProfIT_BPMN_09">
      <bpmn:lane id="lane_own" name="Владелец ProfIT">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_sys" name="Платформа BPMSoft">
        <bpmn:flowNodeRef>ST1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP_ROLE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_ERR1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP_DEACT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_ERR2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_D</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_DONE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_R2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_R</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_REJ</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Запрос администрирования">
      <bpmn:outgoing>flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T1" name="Выбрать сотрудника и назначаемую роль">
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T2" name="Выбрать сотрудника для деактивации">
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:outgoing>flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ST1" name="Проверить роль OWNER и действительность сеанса">
      <bpmn:incoming>flow_0</bpmn:incoming>
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G1" name="Доступ подтверждён?">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G2" name="Тип операции?">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="SP_ROLE" name="Назначение роли">
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:outgoing>flow_8</bpmn:outgoing>
      <bpmn:startEvent id="rS" name="Сотрудник выбран">
        <bpmn:outgoing>SP_ROLE_if_0</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="rST" name="Сверить RoleCode и PermissionCode с матрицей">
        <bpmn:incoming>SP_ROLE_if_0</bpmn:incoming>
        <bpmn:outgoing>SP_ROLE_if_1</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="rG" name="Настройки допустимы?">
        <bpmn:incoming>SP_ROLE_if_1</bpmn:incoming>
        <bpmn:outgoing>SP_ROLE_if_2</bpmn:outgoing>
        <bpmn:outgoing>SP_ROLE_if_3</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="rST2" name="Сохранить роль штатными механизмами">
        <bpmn:incoming>SP_ROLE_if_2</bpmn:incoming>
        <bpmn:outgoing>SP_ROLE_if_4</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="rE1" name="Роль применена">
        <bpmn:incoming>SP_ROLE_if_4</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="rE2" name="Настройки отклонены">
        <bpmn:incoming>SP_ROLE_if_3</bpmn:incoming>
        <bpmn:errorEventDefinition id="erd_rE2" />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SP_ROLE_if_0" sourceRef="rS" targetRef="rST" />
      <bpmn:sequenceFlow id="SP_ROLE_if_1" sourceRef="rST" targetRef="rG" />
      <bpmn:sequenceFlow id="SP_ROLE_if_2" name="Да" sourceRef="rG" targetRef="rST2" />
      <bpmn:sequenceFlow id="SP_ROLE_if_3" name="Нет" sourceRef="rG" targetRef="rE2" />
      <bpmn:sequenceFlow id="SP_ROLE_if_4" sourceRef="rST2" targetRef="rE1" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="B_ERR1" name="Отказ" attachedToRef="SP_ROLE">
      <bpmn:outgoing>flow_12</bpmn:outgoing>
      <bpmn:errorEventDefinition id="erd_B_ERR1" />
    </bpmn:boundaryEvent>
    <bpmn:subProcess id="SP_DEACT" name="Деактивация сотрудника">
      <bpmn:incoming>flow_7</bpmn:incoming>
      <bpmn:outgoing>flow_9</bpmn:outgoing>
      <bpmn:startEvent id="dS" name="Сотрудник выбран">
        <bpmn:outgoing>SP_DEACT_if_0</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="dST" name="Проверить право ACCOUNT_DEACTIVATE">
        <bpmn:incoming>SP_DEACT_if_0</bpmn:incoming>
        <bpmn:outgoing>SP_DEACT_if_1</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="dG" name="Деактивация разрешена?">
        <bpmn:incoming>SP_DEACT_if_1</bpmn:incoming>
        <bpmn:outgoing>SP_DEACT_if_2</bpmn:outgoing>
        <bpmn:outgoing>SP_DEACT_if_3</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="dST2" name="Деактивировать запись и отозвать сеансы">
        <bpmn:incoming>SP_DEACT_if_2</bpmn:incoming>
        <bpmn:outgoing>SP_DEACT_if_4</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="dE1" name="Деактивировано">
        <bpmn:incoming>SP_DEACT_if_4</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="dE2" name="Деактивация запрещена">
        <bpmn:incoming>SP_DEACT_if_3</bpmn:incoming>
        <bpmn:errorEventDefinition id="erd_dE2" />
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SP_DEACT_if_0" sourceRef="dS" targetRef="dST" />
      <bpmn:sequenceFlow id="SP_DEACT_if_1" sourceRef="dST" targetRef="dG" />
      <bpmn:sequenceFlow id="SP_DEACT_if_2" name="Да" sourceRef="dG" targetRef="dST2" />
      <bpmn:sequenceFlow id="SP_DEACT_if_3" name="Нет" sourceRef="dG" targetRef="dE2" />
      <bpmn:sequenceFlow id="SP_DEACT_if_4" sourceRef="dST2" targetRef="dE1" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="B_ERR2" name="Отказ" attachedToRef="SP_DEACT">
      <bpmn:outgoing>flow_13</bpmn:outgoing>
      <bpmn:errorEventDefinition id="erd_B_ERR2" />
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="J_D" name="">
      <bpmn:incoming>flow_8</bpmn:incoming>
      <bpmn:incoming>flow_9</bpmn:incoming>
      <bpmn:outgoing>flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ST6" name="Зафиксировать изменения и проверить доступ">
      <bpmn:incoming>flow_10</bpmn:incoming>
      <bpmn:outgoing>flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E_DONE" name="Изменения применены">
      <bpmn:incoming>flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="J_R2" name="">
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:incoming>flow_12</bpmn:incoming>
      <bpmn:outgoing>flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="J_R" name="">
      <bpmn:incoming>flow_13</bpmn:incoming>
      <bpmn:incoming>flow_14</bpmn:incoming>
      <bpmn:outgoing>flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_REJ" name="Операция отклонена">
      <bpmn:incoming>flow_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_0" sourceRef="S1" targetRef="ST1" />
    <bpmn:sequenceFlow id="flow_1" sourceRef="ST1" targetRef="G1" />
    <bpmn:sequenceFlow id="flow_2" name="Да" sourceRef="G1" targetRef="G2" />
    <bpmn:sequenceFlow id="flow_3" name="Нет" sourceRef="G1" targetRef="J_R2" />
