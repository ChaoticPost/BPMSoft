    <bpmn:sequenceFlow id="flow_6" sourceRef="T1" targetRef="SP_ROLE" />
    <bpmn:sequenceFlow id="flow_7" sourceRef="T2" targetRef="SP_DEACT" />
    <bpmn:sequenceFlow id="flow_8" sourceRef="SP_ROLE" targetRef="J_D" />
    <bpmn:sequenceFlow id="flow_9" sourceRef="SP_DEACT" targetRef="J_D" />
    <bpmn:sequenceFlow id="flow_10" sourceRef="J_D" targetRef="ST6" />
    <bpmn:sequenceFlow id="flow_11" sourceRef="ST6" targetRef="E_DONE" />
    <bpmn:sequenceFlow id="flow_12" sourceRef="B_ERR1" targetRef="J_R2" />
    <bpmn:sequenceFlow id="flow_13" sourceRef="B_ERR2" targetRef="J_R" />
    <bpmn:sequenceFlow id="flow_14" sourceRef="J_R2" targetRef="J_R" />
    <bpmn:sequenceFlow id="flow_15" sourceRef="J_R" targetRef="E_REJ" />
  </bpmn:process>
