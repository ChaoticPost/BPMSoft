<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ProfIT_BPMN_07" targetNamespace="http://bpmn.io/schema/bpmn" exporter="ProfIT BPMN build" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_ProfIT_BPMN_07">
    <bpmn:participant id="Pool_ProfIT_BPMN_07" name="ProfIT — отмена, истечение сроков и аннуляция промокода (BPMN-07)" processRef="Process_ProfIT_BPMN_07"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_ProfIT_BPMN_07" name="ProfIT — отмена, истечение сроков и аннуляция промокода (BPMN-07)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ProfIT_BPMN_07">
      <bpmn:lane id="lane_own" name="Владелец ProfIT">
        <bpmn:flowNodeRef>S_C</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_C</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_sys" name="Платформа BPMSoft">
        <bpmn:flowNodeRef>S_A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP_A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_RA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_B</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP_B</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_RB</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP_C</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_RC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_D1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_D2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_DONE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_N1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_N2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_NO</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S_C" name="Запрос владельца на отмену промокода">
      <bpmn:outgoing>flow_8</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T_C" name="Ввести причину отмены">
      <bpmn:incoming>flow_8</bpmn:incoming>
      <bpmn:outgoing>flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:startEvent id="S_A" name="Плановая проверка deliveryDeadlineAt">
      <bpmn:outgoing>flow_0</bpmn:outgoing>
      <bpmn:timerEventDefinition id="ted_S_A"/>
    </bpmn:startEvent>
    <bpmn:subProcess id="SP_A" name="Аннуляция по таймауту отправки">
      <bpmn:incoming>flow_0</bpmn:incoming>
      <bpmn:outgoing>flow_1</bpmn:outgoing>
      <bpmn:startEvent id="aS" name="Проверка запущена">
        <bpmn:outgoing>SP_A_if_0</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="aST" name="Найти CREATED с истёкшим сроком">
        <bpmn:incoming>SP_A_if_0</bpmn:incoming>
        <bpmn:outgoing>SP_A_if_1</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="aG" name="Есть просроченные?">
        <bpmn:incoming>SP_A_if_1</bpmn:incoming>
        <bpmn:outgoing>SP_A_if_2</bpmn:outgoing>
        <bpmn:outgoing>SP_A_if_3</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="aST2" name="Аннулировать: ANNULLED, DISPATCH_TIMEOUT">
        <bpmn:incoming>SP_A_if_2</bpmn:incoming>
        <bpmn:outgoing>SP_A_if_4</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="aE1" name="Аннулировано">
        <bpmn:incoming>SP_A_if_4</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="aE2" name="Без изменений">
        <bpmn:incoming>SP_A_if_3</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SP_A_if_0" sourceRef="aS" targetRef="aST"/>
      <bpmn:sequenceFlow id="SP_A_if_1" sourceRef="aST" targetRef="aG"/>
      <bpmn:sequenceFlow id="SP_A_if_2" name="Да" sourceRef="aG" targetRef="aST2"/>
      <bpmn:sequenceFlow id="SP_A_if_3" name="Нет" sourceRef="aG" targetRef="aE2"/>
      <bpmn:sequenceFlow id="SP_A_if_4" sourceRef="aST2" targetRef="aE1"/>
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="G_RA" name="Код аннулирован?">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:startEvent id="S_B" name="Плановая проверка expiresAt">
      <bpmn:outgoing>flow_4</bpmn:outgoing>
      <bpmn:timerEventDefinition id="ted_S_B"/>
    </bpmn:startEvent>
    <bpmn:subProcess id="SP_B" name="Аннуляция по истечении годности">
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
      <bpmn:startEvent id="bS" name="Проверка запущена">
        <bpmn:outgoing>SP_B_if_0</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="bST" name="Найти READY_TO_ACTIVATE с истёкшим сроком">
        <bpmn:incoming>SP_B_if_0</bpmn:incoming>
        <bpmn:outgoing>SP_B_if_1</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="bG" name="Есть просроченные?">
        <bpmn:incoming>SP_B_if_1</bpmn:incoming>
        <bpmn:outgoing>SP_B_if_2</bpmn:outgoing>
        <bpmn:outgoing>SP_B_if_3</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="bST2" name="Аннулировать: ANNULLED, VALIDITY_EXPIRED">
        <bpmn:incoming>SP_B_if_2</bpmn:incoming>
        <bpmn:outgoing>SP_B_if_4</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="bE1" name="Аннулировано">
        <bpmn:incoming>SP_B_if_4</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="bE2" name="Без изменений">
        <bpmn:incoming>SP_B_if_3</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SP_B_if_0" sourceRef="bS" targetRef="bST"/>
      <bpmn:sequenceFlow id="SP_B_if_1" sourceRef="bST" targetRef="bG"/>
      <bpmn:sequenceFlow id="SP_B_if_2" name="Да" sourceRef="bG" targetRef="bST2"/>
      <bpmn:sequenceFlow id="SP_B_if_3" name="Нет" sourceRef="bG" targetRef="bE2"/>
      <bpmn:sequenceFlow id="SP_B_if_4" sourceRef="bST2" targetRef="bE1"/>
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="G_RB" name="Код аннулирован?">
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
      <bpmn:outgoing>flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="SP_C" name="Ручная отмена промокода">
      <bpmn:incoming>flow_9</bpmn:incoming>
      <bpmn:outgoing>flow_10</bpmn:outgoing>
      <bpmn:startEvent id="cS" name="Причина введена">
        <bpmn:outgoing>SP_C_if_0</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="cST" name="Проверить OWNER, PROMO_CANCEL и статус">
        <bpmn:incoming>SP_C_if_0</bpmn:incoming>
        <bpmn:outgoing>SP_C_if_1</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="cG" name="Отмена допустима?">
        <bpmn:incoming>SP_C_if_1</bpmn:incoming>
        <bpmn:outgoing>SP_C_if_2</bpmn:outgoing>
        <bpmn:outgoing>SP_C_if_3</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="cST2" name="Отменить: CANCELLED, cancelledAt, причина">
        <bpmn:incoming>SP_C_if_2</bpmn:incoming>
        <bpmn:outgoing>SP_C_if_4</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="cE1" name="Отменено">
        <bpmn:incoming>SP_C_if_4</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="cE2" name="Без изменений">
        <bpmn:incoming>SP_C_if_3</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SP_C_if_0" sourceRef="cS" targetRef="cST"/>
      <bpmn:sequenceFlow id="SP_C_if_1" sourceRef="cST" targetRef="cG"/>
      <bpmn:sequenceFlow id="SP_C_if_2" name="Да" sourceRef="cG" targetRef="cST2"/>
      <bpmn:sequenceFlow id="SP_C_if_3" name="Нет" sourceRef="cG" targetRef="cE2"/>
      <bpmn:sequenceFlow id="SP_C_if_4" sourceRef="cST2" targetRef="cE1"/>
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="G_RC" name="Код отменён?">
      <bpmn:incoming>flow_10</bpmn:incoming>
      <bpmn:outgoing>flow_11</bpmn:outgoing>
      <bpmn:outgoing>flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="J_D1" name="">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:outgoing>flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="J_D2" name="">
      <bpmn:incoming>flow_11</bpmn:incoming>
      <bpmn:incoming>flow_13</bpmn:incoming>
      <bpmn:outgoing>flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_DONE" name="Состояние промокода зафиксировано">
      <bpmn:incoming>flow_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="J_N1" name="">
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:incoming>flow_7</bpmn:incoming>
      <bpmn:outgoing>flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="J_N2" name="">
      <bpmn:incoming>flow_12</bpmn:incoming>
      <bpmn:incoming>flow_15</bpmn:incoming>
      <bpmn:outgoing>flow_16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_NO" name="Проверено, изменений не внесено">
      <bpmn:incoming>flow_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_0" sourceRef="S_A" targetRef="SP_A"/>
    <bpmn:sequenceFlow id="flow_1" sourceRef="SP_A" targetRef="G_RA"/>
    <bpmn:sequenceFlow id="flow_2" name="Да" sourceRef="G_RA" targetRef="J_D1"/>
    <bpmn:sequenceFlow id="flow_3" name="Нет" sourceRef="G_RA" targetRef="J_N1"/>
    <bpmn:sequenceFlow id="flow_4" sourceRef="S_B" targetRef="SP_B"/>
    <bpmn:sequenceFlow id="flow_5" sourceRef="SP_B" targetRef="G_RB"/>
    <bpmn:sequenceFlow id="flow_6" name="Да" sourceRef="G_RB" targetRef="J_D1"/>
    <bpmn:sequenceFlow id="flow_7" name="Нет" sourceRef="G_RB" targetRef="J_N1"/>
    <bpmn:sequenceFlow id="flow_8" sourceRef="S_C" targetRef="T_C"/>
    <bpmn:sequenceFlow id="flow_9" sourceRef="T_C" targetRef="SP_C"/>
    <bpmn:sequenceFlow id="flow_10" sourceRef="SP_C" targetRef="G_RC"/>
    <bpmn:sequenceFlow id="flow_11" name="Да" sourceRef="G_RC" targetRef="J_D2"/>
    <bpmn:sequenceFlow id="flow_12" name="Нет" sourceRef="G_RC" targetRef="J_N2"/>
    <bpmn:sequenceFlow id="flow_13" sourceRef="J_D1" targetRef="J_D2"/>
    <bpmn:sequenceFlow id="flow_14" sourceRef="J_D2" targetRef="E_DONE"/>
    <bpmn:sequenceFlow id="flow_15" sourceRef="J_N1" targetRef="J_N2"/>
    <bpmn:sequenceFlow id="flow_16" sourceRef="J_N2" targetRef="E_NO"/>
  </bpmn:process>
