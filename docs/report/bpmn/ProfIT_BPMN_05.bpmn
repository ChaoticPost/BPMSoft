<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ProfIT_BPMN_05" targetNamespace="http://bpmn.io/schema/bpmn" exporter="ProfIT BPMN build" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_ProfIT_BPMN_05">
    <bpmn:participant id="Pool_ProfIT_BPMN_05" name="ProfIT — создание промокода и обработка почтовых событий (BPMN-05)" processRef="Process_ProfIT_BPMN_05" />
    <bpmn:participant id="PROV" name="Почтовый провайдер" />
    <bpmn:participant id="RCPT" name="Получатель письма" />
    <bpmn:messageFlow id="msg_0" name="Письмо с промокодом" sourceRef="SND1" targetRef="PROV" />
    <bpmn:messageFlow id="msg_1" name="ACCEPTED" sourceRef="PROV" targetRef="M_ACC" />
    <bpmn:messageFlow id="msg_2" name="FAILED" sourceRef="PROV" targetRef="M_FAIL" />
    <bpmn:messageFlow id="msg_3" name="DELIVERED" sourceRef="PROV" targetRef="M_DEL" />
    <bpmn:messageFlow id="msg_4" name="FAILED" sourceRef="PROV" targetRef="M_DFL" />
    <bpmn:messageFlow id="msg_5" name="Доставка письма" sourceRef="PROV" targetRef="RCPT" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ProfIT_BPMN_05" name="ProfIT — создание промокода и обработка почтовых событий (BPMN-05)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ProfIT_BPMN_05">
      <bpmn:lane id="lane_sys" name="Ядро BPMSoft">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_SND</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GEV1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_ACC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GEV2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_DEL</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_OUT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_DFL</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_X</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M_FAIL</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_R</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_FAIL</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_WIN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_ces" name="CES / воркер отправки">
        <bpmn:flowNodeRef>SND1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Подтверждено основание GAME / TEST">
      <bpmn:outgoing>flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ST1" name="Проверить основание и уникальность кода">
      <bpmn:incoming>flow_0</bpmn:incoming>
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G1" name="Основание допустимо, кода нет?">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E2" name="Выдача отклонена">
      <bpmn:incoming>flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ST2" name="Создать PromoCode (CREATED) и попытку № 1">
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="J_SND" name="">
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:incoming>flow_26</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="GEV1" name="Результат отправки">
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:outgoing>flow_7</bpmn:outgoing>
      <bpmn:outgoing>flow_8</bpmn:outgoing>
      <bpmn:outgoing>flow_9</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="M_ACC" name="ACCEPTED_BY_PROVIDER">
      <bpmn:incoming>flow_7</bpmn:incoming>
      <bpmn:outgoing>flow_10</bpmn:outgoing>
      <bpmn:messageEventDefinition id="med_M_ACC" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="ST3" name="Обновить acceptedAt, sentAt, expiresAt → READY_TO_ACTIVATE">
      <bpmn:incoming>flow_10</bpmn:incoming>
      <bpmn:outgoing>flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:eventBasedGateway id="GEV2" name="Событие доставки">
      <bpmn:incoming>flow_11</bpmn:incoming>
      <bpmn:outgoing>flow_12</bpmn:outgoing>
      <bpmn:outgoing>flow_13</bpmn:outgoing>
      <bpmn:outgoing>flow_14</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="M_DEL" name="DELIVERED">
      <bpmn:incoming>flow_12</bpmn:incoming>
      <bpmn:outgoing>flow_15</bpmn:outgoing>
      <bpmn:messageEventDefinition id="med_M_DEL" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="ST4" name="Зафиксировать deliveredAt">
      <bpmn:incoming>flow_15</bpmn:incoming>
      <bpmn:outgoing>flow_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E1" name="Готов к активации (доставлено)">
      <bpmn:incoming>flow_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="T_OUT" name="Истёк deliveryDeadlineAt">
      <bpmn:incoming>flow_8</bpmn:incoming>
      <bpmn:outgoing>flow_27</bpmn:outgoing>
      <bpmn:timerEventDefinition id="ted_T_OUT" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="ST9" name="Аннулировать: ANNULLED, DISPATCH_TIMEOUT">
      <bpmn:incoming>flow_27</bpmn:incoming>
      <bpmn:outgoing>flow_28</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E4" name="Аннулирован по таймауту отправки">
      <bpmn:incoming>flow_28</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="M_DFL" name="FAILED (доставка)">
      <bpmn:incoming>flow_13</bpmn:incoming>
      <bpmn:outgoing>flow_17</bpmn:outgoing>
      <bpmn:messageEventDefinition id="med_M_DFL" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="ST5" name="Отметить недоставку в истории попытки">
      <bpmn:incoming>flow_17</bpmn:incoming>
      <bpmn:outgoing>flow_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="J_X" name="">
      <bpmn:incoming>flow_18</bpmn:incoming>
      <bpmn:incoming>flow_20</bpmn:incoming>
      <bpmn:outgoing>flow_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E3" name="Готов к активации (доставка не подтверждена)">
      <bpmn:incoming>flow_21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="M_FAIL" name="FAILED / ошибка приёма">
      <bpmn:incoming>flow_9</bpmn:incoming>
      <bpmn:outgoing>flow_22</bpmn:outgoing>
      <bpmn:messageEventDefinition id="med_M_FAIL" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="ST7" name="Зафиксировать ошибку приёма">
      <bpmn:incoming>flow_22</bpmn:incoming>
      <bpmn:outgoing>flow_23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_R" name="Нужен повтор и время есть?">
      <bpmn:incoming>flow_23</bpmn:incoming>
      <bpmn:outgoing>flow_24</bpmn:outgoing>
      <bpmn:outgoing>flow_25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ST8" name="Создать новую PromoSendAttempt">
      <bpmn:incoming>flow_24</bpmn:incoming>
      <bpmn:outgoing>flow_26</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E_FAIL" name="Отправка завершилась ошибкой">
      <bpmn:incoming>flow_25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="T_WIN" name="Окно ожидания доставки истекло">
      <bpmn:incoming>flow_14</bpmn:incoming>
      <bpmn:outgoing>flow_19</bpmn:outgoing>
      <bpmn:timerEventDefinition id="ted_T_WIN" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="ST6" name="Сохранить неопределённость истории">
      <bpmn:incoming>flow_19</bpmn:incoming>
      <bpmn:outgoing>flow_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="SND1" name="Передать письмо провайдеру">
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="flow_0" sourceRef="S1" targetRef="ST1" />
    <bpmn:sequenceFlow id="flow_1" sourceRef="ST1" targetRef="G1" />
