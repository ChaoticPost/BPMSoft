<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ProfIT_BPMN_05" targetNamespace="http://bpmn.io/schema/bpmn" exporter="ProfIT BPMN build" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_ProfIT_BPMN_05">
    <bpmn:participant id="Pool_ProfIT_BPMN_05" name="ProfIT — создание промокода и обработка почтовых событий (BPMN-05)" processRef="Process_ProfIT_BPMN_05"/>
    <bpmn:participant id="PROV" name="Почтовый провайдер"/>
    <bpmn:participant id="RCPT" name="Получатель письма"/>
    <bpmn:messageFlow id="msg_0" name="Письмо с промокодом" sourceRef="iSND" targetRef="PROV"/>
    <bpmn:messageFlow id="msg_1" name="ACCEPTED" sourceRef="PROV" targetRef="iACC"/>
    <bpmn:messageFlow id="msg_2" name="FAILED" sourceRef="PROV" targetRef="iFAIL"/>
    <bpmn:messageFlow id="msg_3" name="DELIVERED" sourceRef="PROV" targetRef="dDEL"/>
    <bpmn:messageFlow id="msg_4" name="FAILED" sourceRef="PROV" targetRef="dFAIL"/>
    <bpmn:messageFlow id="msg_5" name="Доставка письма" sourceRef="PROV" targetRef="RCPT"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_ProfIT_BPMN_05" name="ProfIT — создание промокода и обработка почтовых событий (BPMN-05)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ProfIT_BPMN_05">
      <bpmn:lane id="lane_sys" name="Ядро BPMSoft">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_SND</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_FAIL</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_X</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_ANN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_R</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_ces" name="CES / воркер отправки">
        <bpmn:flowNodeRef>SP_SEND</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_T</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_ERR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP_DELIV</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_WIN</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_ERR2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Подтверждено основание GAME / TEST">
      <bpmn:outgoing>flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ST1" name="Проверить основание и уникальность кода">
      <bpmn:incoming>flow_0</bpmn:incoming>
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G1" name="Основание допустимо, кода нет?">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E2" name="Выдача отклонена">
      <bpmn:incoming>flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ST2" name="Создать PromoCode (CREATED) и попытку № 1">
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="J_SND" name="">
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:incoming>flow_11</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ST3" name="Обновить acceptedAt, sentAt, expiresAt → READY_TO_ACTIVATE">
      <bpmn:incoming>flow_12</bpmn:incoming>
      <bpmn:outgoing>flow_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ST4" name="Зафиксировать deliveredAt">
      <bpmn:incoming>flow_16</bpmn:incoming>
      <bpmn:outgoing>flow_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E1" name="Готов к активации (доставлено)">
      <bpmn:incoming>flow_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="E_FAIL" name="Отправка завершилась ошибкой">
      <bpmn:incoming>flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ST5" name="Отметить недоставку в истории попытки">
      <bpmn:incoming>flow_15</bpmn:incoming>
      <bpmn:outgoing>flow_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="J_X" name="">
      <bpmn:incoming>flow_18</bpmn:incoming>
      <bpmn:incoming>flow_19</bpmn:incoming>
      <bpmn:outgoing>flow_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E3" name="Готов к активации (доставка не подтверждена)">
      <bpmn:incoming>flow_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ST_ANN" name="Аннулировать: ANNULLED, DISPATCH_TIMEOUT">
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:outgoing>flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E4" name="Аннулирован по таймауту отправки">
      <bpmn:incoming>flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="G_R" name="Повтор допустим и время есть?">
      <bpmn:incoming>flow_8</bpmn:incoming>
      <bpmn:outgoing>flow_9</bpmn:outgoing>
      <bpmn:outgoing>flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ST8" name="Создать новую PromoSendAttempt">
      <bpmn:incoming>flow_9</bpmn:incoming>
      <bpmn:outgoing>flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ST6" name="Сохранить неопределённость истории">
      <bpmn:incoming>flow_14</bpmn:incoming>
      <bpmn:outgoing>flow_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:subProcess id="SP_SEND" name="Отправка письма и ожидание приёма">
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:outgoing>flow_12</bpmn:outgoing>
      <bpmn:startEvent id="iS" name="Попытка создана">
        <bpmn:outgoing>SP_SEND_if_0</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:sendTask id="iSND" name="Передать письмо провайдеру">
        <bpmn:incoming>SP_SEND_if_0</bpmn:incoming>
        <bpmn:outgoing>SP_SEND_if_1</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:eventBasedGateway id="iGEV" name="Результат приёма">
        <bpmn:incoming>SP_SEND_if_1</bpmn:incoming>
        <bpmn:outgoing>SP_SEND_if_2</bpmn:outgoing>
        <bpmn:outgoing>SP_SEND_if_3</bpmn:outgoing>
      </bpmn:eventBasedGateway>
      <bpmn:intermediateCatchEvent id="iACC" name="ACCEPTED_BY_PROVIDER">
        <bpmn:incoming>SP_SEND_if_2</bpmn:incoming>
        <bpmn:outgoing>SP_SEND_if_4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="med_iACC"/>
      </bpmn:intermediateCatchEvent>
      <bpmn:intermediateCatchEvent id="iFAIL" name="FAILED / ошибка приёма">
        <bpmn:incoming>SP_SEND_if_3</bpmn:incoming>
        <bpmn:outgoing>SP_SEND_if_5</bpmn:outgoing>
      <bpmn:messageEventDefinition id="med_iFAIL"/>
      </bpmn:intermediateCatchEvent>
      <bpmn:endEvent id="iE_OK" name="Принято провайдером">
        <bpmn:incoming>SP_SEND_if_4</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="iE_ERR" name="Не принято">
        <bpmn:incoming>SP_SEND_if_5</bpmn:incoming>
      <bpmn:errorEventDefinition id="erd_iE_ERR"/>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SP_SEND_if_0" sourceRef="iS" targetRef="iSND"/>
      <bpmn:sequenceFlow id="SP_SEND_if_1" sourceRef="iSND" targetRef="iGEV"/>
      <bpmn:sequenceFlow id="SP_SEND_if_2" sourceRef="iGEV" targetRef="iACC"/>
      <bpmn:sequenceFlow id="SP_SEND_if_3" sourceRef="iGEV" targetRef="iFAIL"/>
      <bpmn:sequenceFlow id="SP_SEND_if_4" sourceRef="iACC" targetRef="iE_OK"/>
      <bpmn:sequenceFlow id="SP_SEND_if_5" sourceRef="iFAIL" targetRef="iE_ERR"/>
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="B_T" name="deliveryDeadlineAt" attachedToRef="SP_SEND" cancelActivity="true">
      <bpmn:outgoing>flow_6</bpmn:outgoing>
      <bpmn:timerEventDefinition id="ted_B_T"/>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="B_ERR" name="Приём не удался" attachedToRef="SP_SEND" cancelActivity="true">
      <bpmn:outgoing>flow_8</bpmn:outgoing>
      <bpmn:errorEventDefinition id="erd_B_ERR"/>
    </bpmn:boundaryEvent>
    <bpmn:subProcess id="SP_DELIV" name="Ожидание доставки">
      <bpmn:incoming>flow_13</bpmn:incoming>
      <bpmn:outgoing>flow_16</bpmn:outgoing>
      <bpmn:startEvent id="dS" name="Письмо принято">
        <bpmn:outgoing>SP_DELIV_if_0</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:eventBasedGateway id="dGEV" name="Событие доставки">
        <bpmn:incoming>SP_DELIV_if_0</bpmn:incoming>
        <bpmn:outgoing>SP_DELIV_if_1</bpmn:outgoing>
        <bpmn:outgoing>SP_DELIV_if_2</bpmn:outgoing>
      </bpmn:eventBasedGateway>
      <bpmn:intermediateCatchEvent id="dDEL" name="DELIVERED">
        <bpmn:incoming>SP_DELIV_if_1</bpmn:incoming>
        <bpmn:outgoing>SP_DELIV_if_3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="med_dDEL"/>
      </bpmn:intermediateCatchEvent>
      <bpmn:intermediateCatchEvent id="dFAIL" name="FAILED (доставка)">
        <bpmn:incoming>SP_DELIV_if_2</bpmn:incoming>
        <bpmn:outgoing>SP_DELIV_if_4</bpmn:outgoing>
      <bpmn:messageEventDefinition id="med_dFAIL"/>
      </bpmn:intermediateCatchEvent>
      <bpmn:endEvent id="dE_OK" name="Доставлено">
        <bpmn:incoming>SP_DELIV_if_3</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="dE_ERR" name="Доставка не удалась">
        <bpmn:incoming>SP_DELIV_if_4</bpmn:incoming>
      <bpmn:errorEventDefinition id="erd_dE_ERR"/>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SP_DELIV_if_0" sourceRef="dS" targetRef="dGEV"/>
      <bpmn:sequenceFlow id="SP_DELIV_if_1" sourceRef="dGEV" targetRef="dDEL"/>
      <bpmn:sequenceFlow id="SP_DELIV_if_2" sourceRef="dGEV" targetRef="dFAIL"/>
      <bpmn:sequenceFlow id="SP_DELIV_if_3" sourceRef="dDEL" targetRef="dE_OK"/>
      <bpmn:sequenceFlow id="SP_DELIV_if_4" sourceRef="dFAIL" targetRef="dE_ERR"/>
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="B_WIN" name="Окно доставки истекло" attachedToRef="SP_DELIV" cancelActivity="true">
      <bpmn:outgoing>flow_14</bpmn:outgoing>
      <bpmn:timerEventDefinition id="ted_B_WIN"/>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="B_ERR2" name="Доставка не удалась" attachedToRef="SP_DELIV" cancelActivity="true">
      <bpmn:outgoing>flow_15</bpmn:outgoing>
      <bpmn:errorEventDefinition id="erd_B_ERR2"/>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="flow_0" sourceRef="S1" targetRef="ST1"/>
    <bpmn:sequenceFlow id="flow_1" sourceRef="ST1" targetRef="G1"/>
    <bpmn:sequenceFlow id="flow_2" name="Нет" sourceRef="G1" targetRef="E2"/>
    <bpmn:sequenceFlow id="flow_3" name="Да" sourceRef="G1" targetRef="ST2"/>
    <bpmn:sequenceFlow id="flow_4" sourceRef="ST2" targetRef="J_SND"/>
    <bpmn:sequenceFlow id="flow_5" sourceRef="J_SND" targetRef="SP_SEND"/>
    <bpmn:sequenceFlow id="flow_6" sourceRef="B_T" targetRef="ST_ANN"/>
    <bpmn:sequenceFlow id="flow_7" sourceRef="ST_ANN" targetRef="E4"/>
    <bpmn:sequenceFlow id="flow_8" sourceRef="B_ERR" targetRef="G_R"/>
    <bpmn:sequenceFlow id="flow_9" name="Да" sourceRef="G_R" targetRef="ST8"/>
    <bpmn:sequenceFlow id="flow_10" name="Нет" sourceRef="G_R" targetRef="E_FAIL"/>
    <bpmn:sequenceFlow id="flow_11" sourceRef="ST8" targetRef="J_SND"/>
    <bpmn:sequenceFlow id="flow_12" sourceRef="SP_SEND" targetRef="ST3"/>
    <bpmn:sequenceFlow id="flow_13" sourceRef="ST3" targetRef="SP_DELIV"/>
    <bpmn:sequenceFlow id="flow_14" sourceRef="B_WIN" targetRef="ST6"/>
    <bpmn:sequenceFlow id="flow_15" sourceRef="B_ERR2" targetRef="ST5"/>
    <bpmn:sequenceFlow id="flow_16" sourceRef="SP_DELIV" targetRef="ST4"/>
    <bpmn:sequenceFlow id="flow_17" sourceRef="ST4" targetRef="E1"/>
    <bpmn:sequenceFlow id="flow_18" sourceRef="ST5" targetRef="J_X"/>
    <bpmn:sequenceFlow id="flow_19" sourceRef="ST6" targetRef="J_X"/>
    <bpmn:sequenceFlow id="flow_20" sourceRef="J_X" targetRef="E3"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDI_ProfIT_BPMN_05">
    <bpmndi:BPMNPlane id="BPMNPlane_ProfIT_BPMN_05" bpmnElement="Collab_ProfIT_BPMN_05">
