<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ProfIT_BPMN_03" targetNamespace="http://bpmn.io/schema/bpmn" exporter="ProfIT BPMN build" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_ProfIT_BPMN_03">
    <bpmn:participant id="Pool_ProfIT_BPMN_03" name="ProfIT — прохождение онлайн-теста (BPMN-03)" processRef="Process_ProfIT_BPMN_03" />
    <bpmn:participant id="PUB" name="Публичный пользователь (Web/Mobile)" />
    <bpmn:messageFlow id="msg_0" name="Выбор теста" sourceRef="PUB" targetRef="S1" />
    <bpmn:messageFlow id="msg_1" name="Вопросы теста" sourceRef="SND1" targetRef="PUB" />
    <bpmn:messageFlow id="msg_2" name="Ответ / завершение" sourceRef="PUB" targetRef="RCV" />
    <bpmn:messageFlow id="msg_3" name="Ошибка ввода" sourceRef="SND_ERR" targetRef="PUB" />
    <bpmn:messageFlow id="msg_4" name="Результат" sourceRef="SND4" targetRef="PUB" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ProfIT_BPMN_03" name="ProfIT — прохождение онлайн-теста (BPMN-03)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ProfIT_BPMN_03">
      <bpmn:lane id="lane_api" name="Интеграционный API BPMSoft">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SND1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_B</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RCV</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_CMD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_ERR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SND_ERR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SND4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_sys" name="Ядро BPMSoft">
        <bpmn:flowNodeRef>ST1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_END</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Запрос прохождения опубликованного теста">
      <bpmn:outgoing>flow_0</bpmn:outgoing>
      <bpmn:messageEventDefinition id="med_S1" />
    </bpmn:startEvent>
    <bpmn:sendTask id="SND1" name="Выдать вопросы без признака правильности">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="J_A" name="">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:incoming>flow_10</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="J_B" name="">
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:incoming>flow_21</bpmn:incoming>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:receiveTask id="RCV" name="Получить ответ или команду завершения">
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:exclusiveGateway id="G_CMD" name="Команда завершения?">
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
      <bpmn:outgoing>flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="J_ERR" name="">
      <bpmn:incoming>flow_11</bpmn:incoming>
      <bpmn:incoming>flow_13</bpmn:incoming>
      <bpmn:outgoing>flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="SND_ERR" name="Сообщить ошибку и предложить повтор">
      <bpmn:incoming>flow_14</bpmn:incoming>
      <bpmn:outgoing>flow_21</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="SND4" name="Сообщить результат пользователю">
      <bpmn:incoming>flow_20</bpmn:incoming>
      <bpmn:outgoing>flow_22</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="E1" name="Результат показан">
      <bpmn:incoming>flow_22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ST1" name="Создать TestAttempt и выдать attemptToken">
      <bpmn:incoming>flow_0</bpmn:incoming>
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ST4" name="Проверить состояние попытки">
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:outgoing>flow_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G3" name="Завершение допустимо?">
      <bpmn:incoming>flow_12</bpmn:incoming>
      <bpmn:outgoing>flow_13</bpmn:outgoing>
      <bpmn:outgoing>flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ST5" name="Рассчитать score, successful, finishedAt">
      <bpmn:incoming>flow_15</bpmn:incoming>
      <bpmn:outgoing>flow_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G4" name="Тест пройден успешно?">
      <bpmn:incoming>flow_16</bpmn:incoming>
      <bpmn:outgoing>flow_17</bpmn:outgoing>
      <bpmn:outgoing>flow_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ST6" name="Создать основание TEST для промокода">
      <bpmn:incoming>flow_17</bpmn:incoming>
      <bpmn:outgoing>flow_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ST2" name="Проверить ответ: вопрос, версия, дубликат">
      <bpmn:incoming>flow_7</bpmn:incoming>
      <bpmn:outgoing>flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G1" name="Ответ допустим?">
      <bpmn:incoming>flow_8</bpmn:incoming>
      <bpmn:outgoing>flow_9</bpmn:outgoing>
      <bpmn:outgoing>flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ST3" name="Сохранить ответ в попытке">
      <bpmn:incoming>flow_9</bpmn:incoming>
      <bpmn:outgoing>flow_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="J_END" name="">
      <bpmn:incoming>flow_18</bpmn:incoming>
      <bpmn:incoming>flow_19</bpmn:incoming>
      <bpmn:outgoing>flow_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="flow_0" sourceRef="S1" targetRef="ST1" />
    <bpmn:sequenceFlow id="flow_1" sourceRef="ST1" targetRef="SND1" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="SND1" targetRef="J_A" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="J_A" targetRef="J_B" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="J_B" targetRef="RCV" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="RCV" targetRef="G_CMD" />
    <bpmn:sequenceFlow id="flow_6" name="Да" sourceRef="G_CMD" targetRef="ST4" />
    <bpmn:sequenceFlow id="flow_7" name="Нет" sourceRef="G_CMD" targetRef="ST2" />
    <bpmn:sequenceFlow id="flow_8" sourceRef="ST2" targetRef="G1" />
    <bpmn:sequenceFlow id="flow_9" name="Да" sourceRef="G1" targetRef="ST3" />
    <bpmn:sequenceFlow id="flow_10" sourceRef="ST3" targetRef="J_A" />
    <bpmn:sequenceFlow id="flow_11" name="Нет" sourceRef="G1" targetRef="J_ERR" />
    <bpmn:sequenceFlow id="flow_12" sourceRef="ST4" targetRef="G3" />
    <bpmn:sequenceFlow id="flow_13" name="Нет" sourceRef="G3" targetRef="J_ERR" />
    <bpmn:sequenceFlow id="flow_14" sourceRef="J_ERR" targetRef="SND_ERR" />
    <bpmn:sequenceFlow id="flow_15" name="Да" sourceRef="G3" targetRef="ST5" />
    <bpmn:sequenceFlow id="flow_16" sourceRef="ST5" targetRef="G4" />
    <bpmn:sequenceFlow id="flow_17" name="Да" sourceRef="G4" targetRef="ST6" />
    <bpmn:sequenceFlow id="flow_18" name="Нет" sourceRef="G4" targetRef="J_END" />
    <bpmn:sequenceFlow id="flow_19" sourceRef="ST6" targetRef="J_END" />
    <bpmn:sequenceFlow id="flow_20" sourceRef="J_END" targetRef="SND4" />
    <bpmn:sequenceFlow id="flow_21" sourceRef="SND_ERR" targetRef="J_B" />
    <bpmn:sequenceFlow id="flow_22" sourceRef="SND4" targetRef="E1" />
  </bpmn:process>
