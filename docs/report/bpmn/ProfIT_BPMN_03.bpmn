<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ProfIT_BPMN_03" targetNamespace="http://bpmn.io/schema/bpmn" exporter="ProfIT BPMN build" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_ProfIT_BPMN_03">
    <bpmn:participant id="Pool_ProfIT_BPMN_03" name="ProfIT — прохождение онлайн-теста (BPMN-03)" processRef="Process_ProfIT_BPMN_03"/>
    <bpmn:participant id="PUB" name="Публичный пользователь (Web/Mobile)"/>
    <bpmn:messageFlow id="msg_0" name="Выбор теста" sourceRef="PUB" targetRef="S1"/>
    <bpmn:messageFlow id="msg_1" name="Вопросы теста" sourceRef="SND1" targetRef="PUB"/>
    <bpmn:messageFlow id="msg_2" name="Ответ / завершение" sourceRef="PUB" targetRef="iRCV"/>
    <bpmn:messageFlow id="msg_3" name="Ошибка ввода" sourceRef="iERR" targetRef="PUB"/>
    <bpmn:messageFlow id="msg_4" name="Результат" sourceRef="SND4" targetRef="PUB"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_ProfIT_BPMN_03" name="ProfIT — прохождение онлайн-теста (BPMN-03)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ProfIT_BPMN_03">
      <bpmn:lane id="lane_api" name="Интеграционный API BPMSoft">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SND1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_SP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP_ANS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_R</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SND4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_sys" name="Ядро BPMSoft">
        <bpmn:flowNodeRef>ST1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST6</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Запрос прохождения опубликованного теста">
      <bpmn:outgoing>flow_0</bpmn:outgoing>
      <bpmn:messageEventDefinition id="med_S1"/>
    </bpmn:startEvent>
    <bpmn:sendTask id="SND1" name="Выдать вопросы без признака правильности">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="J_SP" name="">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="SP_ANS" name="Ввод ответов попытки">
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
      <bpmn:startEvent id="iS" name="Вопросы выданы">
        <bpmn:outgoing>SP_ANS_if_0</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="iJ" name="">
        <bpmn:incoming>SP_ANS_if_0</bpmn:incoming>
        <bpmn:incoming>SP_ANS_if_1</bpmn:incoming>
        <bpmn:outgoing>SP_ANS_if_2</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="iJ2" name="">
        <bpmn:incoming>SP_ANS_if_2</bpmn:incoming>
        <bpmn:incoming>SP_ANS_if_3</bpmn:incoming>
        <bpmn:outgoing>SP_ANS_if_4</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:receiveTask id="iRCV" name="Получить ответ или завершение">
        <bpmn:incoming>SP_ANS_if_4</bpmn:incoming>
        <bpmn:outgoing>SP_ANS_if_5</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:exclusiveGateway id="iGT" name="Завершить тест?">
        <bpmn:incoming>SP_ANS_if_5</bpmn:incoming>
        <bpmn:outgoing>SP_ANS_if_6</bpmn:outgoing>
        <bpmn:outgoing>SP_ANS_if_7</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="iST" name="Проверить ответ: вопрос, версия, дубликат">
        <bpmn:incoming>SP_ANS_if_6</bpmn:incoming>
        <bpmn:outgoing>SP_ANS_if_8</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="iG" name="Ответ допустим?">
        <bpmn:incoming>SP_ANS_if_8</bpmn:incoming>
        <bpmn:outgoing>SP_ANS_if_9</bpmn:outgoing>
        <bpmn:outgoing>SP_ANS_if_10</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="iE" name="Ввод завершён">
        <bpmn:incoming>SP_ANS_if_7</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:serviceTask id="iSAVE" name="Сохранить ответ">
        <bpmn:incoming>SP_ANS_if_9</bpmn:incoming>
        <bpmn:outgoing>SP_ANS_if_3</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sendTask id="iERR" name="Сообщить ошибку, предложить повтор">
        <bpmn:incoming>SP_ANS_if_10</bpmn:incoming>
        <bpmn:outgoing>SP_ANS_if_1</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:sequenceFlow id="SP_ANS_if_0" sourceRef="iS" targetRef="iJ"/>
      <bpmn:sequenceFlow id="SP_ANS_if_1" sourceRef="iERR" targetRef="iJ"/>
      <bpmn:sequenceFlow id="SP_ANS_if_2" sourceRef="iJ" targetRef="iJ2"/>
      <bpmn:sequenceFlow id="SP_ANS_if_3" sourceRef="iSAVE" targetRef="iJ2"/>
      <bpmn:sequenceFlow id="SP_ANS_if_4" sourceRef="iJ2" targetRef="iRCV"/>
      <bpmn:sequenceFlow id="SP_ANS_if_5" sourceRef="iRCV" targetRef="iGT"/>
      <bpmn:sequenceFlow id="SP_ANS_if_6" name="Нет" sourceRef="iGT" targetRef="iST"/>
      <bpmn:sequenceFlow id="SP_ANS_if_7" name="Да" sourceRef="iGT" targetRef="iE"/>
      <bpmn:sequenceFlow id="SP_ANS_if_8" sourceRef="iST" targetRef="iG"/>
      <bpmn:sequenceFlow id="SP_ANS_if_9" name="Да" sourceRef="iG" targetRef="iSAVE"/>
      <bpmn:sequenceFlow id="SP_ANS_if_10" name="Нет" sourceRef="iG" targetRef="iERR"/>
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="J_R" name="">
      <bpmn:incoming>flow_10</bpmn:incoming>
      <bpmn:incoming>flow_11</bpmn:incoming>
      <bpmn:outgoing>flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="SND4" name="Сообщить результат пользователю">
      <bpmn:incoming>flow_12</bpmn:incoming>
      <bpmn:outgoing>flow_13</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="E1" name="Результат показан">
      <bpmn:incoming>flow_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ST1" name="Создать TestAttempt и выдать attemptToken">
      <bpmn:incoming>flow_0</bpmn:incoming>
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ST4" name="Проверить состояние попытки">
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G3" name="Завершение допустимо?">
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
      <bpmn:outgoing>flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ST5" name="Рассчитать score, successful, finishedAt">
      <bpmn:incoming>flow_7</bpmn:incoming>
      <bpmn:outgoing>flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G4" name="Тест пройден успешно?">
      <bpmn:incoming>flow_8</bpmn:incoming>
      <bpmn:outgoing>flow_9</bpmn:outgoing>
      <bpmn:outgoing>flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ST6" name="Создать основание TEST для промокода">
      <bpmn:incoming>flow_9</bpmn:incoming>
      <bpmn:outgoing>flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="flow_0" sourceRef="S1" targetRef="ST1"/>
    <bpmn:sequenceFlow id="flow_1" sourceRef="ST1" targetRef="SND1"/>
    <bpmn:sequenceFlow id="flow_2" sourceRef="SND1" targetRef="J_SP"/>
    <bpmn:sequenceFlow id="flow_3" name="Нет" sourceRef="G3" targetRef="J_SP"/>
    <bpmn:sequenceFlow id="flow_4" sourceRef="J_SP" targetRef="SP_ANS"/>
    <bpmn:sequenceFlow id="flow_5" sourceRef="SP_ANS" targetRef="ST4"/>
    <bpmn:sequenceFlow id="flow_6" sourceRef="ST4" targetRef="G3"/>
    <bpmn:sequenceFlow id="flow_7" name="Да" sourceRef="G3" targetRef="ST5"/>
    <bpmn:sequenceFlow id="flow_8" sourceRef="ST5" targetRef="G4"/>
    <bpmn:sequenceFlow id="flow_9" name="Да" sourceRef="G4" targetRef="ST6"/>
    <bpmn:sequenceFlow id="flow_10" name="Нет" sourceRef="G4" targetRef="J_R"/>
    <bpmn:sequenceFlow id="flow_11" sourceRef="ST6" targetRef="J_R"/>
    <bpmn:sequenceFlow id="flow_12" sourceRef="J_R" targetRef="SND4"/>
    <bpmn:sequenceFlow id="flow_13" sourceRef="SND4" targetRef="E1"/>
  </bpmn:process>
