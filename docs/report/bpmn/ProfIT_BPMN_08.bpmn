<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ProfIT_BPMN_08" targetNamespace="http://bpmn.io/schema/bpmn" exporter="ProfIT BPMN build" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_ProfIT_BPMN_08">
    <bpmn:participant id="Pool_ProfIT_BPMN_08" name="ProfIT — импорт продаж и отчётность R-1–R-4 (BPMN-08)" processRef="Process_ProfIT_BPMN_08" />
    <bpmn:participant id="TS" name="Внешняя торговая система" />
    <bpmn:messageFlow id="msg_0" name="Пакет продаж (все продажи группы)" sourceRef="TS" targetRef="S_A" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ProfIT_BPMN_08" name="ProfIT — импорт продаж и отчётность R-1–R-4 (BPMN-08)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ProfIT_BPMN_08">
      <bpmn:lane id="lane_own" name="Владелец ProfIT">
        <bpmn:flowNodeRef>S_B</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_B2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_sys" name="Платформа BPMSoft">
        <bpmn:flowNodeRef>S_A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_A1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_A1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_A2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_A3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_A2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_B1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_B</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_B1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_B2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST_B3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_B2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S_B" name="Владелец открыл Insight">
      <bpmn:outgoing>flow_6</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T_B2" name="Задать параметры отчёта (период, когорта)">
      <bpmn:incoming>flow_9</bpmn:incoming>
      <bpmn:outgoing>flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:startEvent id="S_A" name="Пакет продаж от торгового контура">
      <bpmn:outgoing>flow_0</bpmn:outgoing>
      <bpmn:messageEventDefinition id="med_S_A" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="ST_A1" name="Проверить структуру пакета и товарную группу">
      <bpmn:incoming>flow_0</bpmn:incoming>
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_A" name="Пакет корректен?">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_A1" name="Пакет отклонён">
      <bpmn:incoming>flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ST_A2" name="Устранить дубли orderId (идемпотентность)">
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ST_A3" name="Сохранить подтверждённые продажи">
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E_A2" name="Продажи учтены">
      <bpmn:incoming>flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ST_B1" name="Проверить право REPORT_VIEW">
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:outgoing>flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_B" name="Просмотр разрешён?">
      <bpmn:incoming>flow_7</bpmn:incoming>
      <bpmn:outgoing>flow_8</bpmn:outgoing>
      <bpmn:outgoing>flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_B1" name="Отказано в доступе">
      <bpmn:incoming>flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ST_B2" name="Рассчитать показатели R-1–R-4 по когортам sentAt">
      <bpmn:incoming>flow_10</bpmn:incoming>
      <bpmn:outgoing>flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ST_B3" name="Отобразить отчёты в веб-клиенте">
      <bpmn:incoming>flow_11</bpmn:incoming>
      <bpmn:outgoing>flow_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E_B2" name="Отчётность предоставлена">
      <bpmn:incoming>flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_0" sourceRef="S_A" targetRef="ST_A1" />
    <bpmn:sequenceFlow id="flow_1" sourceRef="ST_A1" targetRef="G_A" />
    <bpmn:sequenceFlow id="flow_2" name="Нет" sourceRef="G_A" targetRef="E_A1" />
    <bpmn:sequenceFlow id="flow_3" name="Да" sourceRef="G_A" targetRef="ST_A2" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="ST_A2" targetRef="ST_A3" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="ST_A3" targetRef="E_A2" />
    <bpmn:sequenceFlow id="flow_6" sourceRef="S_B" targetRef="ST_B1" />
    <bpmn:sequenceFlow id="flow_7" sourceRef="ST_B1" targetRef="G_B" />
    <bpmn:sequenceFlow id="flow_8" name="Нет" sourceRef="G_B" targetRef="E_B1" />
    <bpmn:sequenceFlow id="flow_9" name="Да" sourceRef="G_B" targetRef="T_B2" />
    <bpmn:sequenceFlow id="flow_10" sourceRef="T_B2" targetRef="ST_B2" />
    <bpmn:sequenceFlow id="flow_11" sourceRef="ST_B2" targetRef="ST_B3" />
    <bpmn:sequenceFlow id="flow_12" sourceRef="ST_B3" targetRef="E_B2" />
  </bpmn:process>
