<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ProfIT_BPMN_01" targetNamespace="http://bpmn.io/schema/bpmn" exporter="ProfIT BPMN build" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_ProfIT_BPMN_01">
    <bpmn:participant id="Pool_ProfIT_BPMN_01" name="ProfIT — проведение офлайн-турнира (BPMN-01)" processRef="Process_ProfIT_BPMN_01"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_ProfIT_BPMN_01" name="ProfIT — проведение офлайн-турнира (BPMN-01)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ProfIT_BPMN_01">
      <bpmn:lane id="lane_emp" name="Сотрудник ProfIT">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_B</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_MV</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_MOV</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_sys" name="Платформа BPMSoft">
        <bpmn:flowNodeRef>ST1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_RND</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP_CHECK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_ERR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_mv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Сотрудник начинает организацию турнира">
      <bpmn:outgoing>flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T1" name="Создать турнир и выбрать игру">
      <bpmn:incoming>flow_0</bpmn:incoming>
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="J1" name="">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T2" name="Сформировать сессию и состав участников">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="J_B" name="">
      <bpmn:incoming>flow_8</bpmn:incoming>
      <bpmn:incoming>flow_9</bpmn:incoming>
      <bpmn:outgoing>flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="J_MV" name="">
      <bpmn:incoming>flow_10</bpmn:incoming>
      <bpmn:incoming>flow_14</bpmn:incoming>
      <bpmn:outgoing>flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_MOV" name="Зафиксировать ход: объясняющий, слово, способ">
      <bpmn:incoming>flow_11</bpmn:incoming>
      <bpmn:outgoing>flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T4" name="Согласовать исход по регламенту (при ничьей)">
      <bpmn:incoming>flow_20</bpmn:incoming>
      <bpmn:outgoing>flow_21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ST1" name="Проверить состав и допустимость начала">
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G1" name="Состав корректен?">
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="J_RND" name="">
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:incoming>flow_17</bpmn:incoming>
      <bpmn:outgoing>flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ST2" name="Открыть раунд">
      <bpmn:incoming>flow_7</bpmn:incoming>
      <bpmn:outgoing>flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:subProcess id="SP_CHECK" name="Обработка и учёт хода">
      <bpmn:incoming>flow_12</bpmn:incoming>
      <bpmn:outgoing>flow_13</bpmn:outgoing>
      <bpmn:startEvent id="iS" name="Ход зафиксирован">
        <bpmn:outgoing>SP_CHECK_if_0</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="iST" name="Проверить ход и версию правила playedAt">
        <bpmn:incoming>SP_CHECK_if_0</bpmn:incoming>
        <bpmn:outgoing>SP_CHECK_if_1</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="iG" name="Ход корректен?">
        <bpmn:incoming>SP_CHECK_if_1</bpmn:incoming>
        <bpmn:outgoing>SP_CHECK_if_2</bpmn:outgoing>
        <bpmn:outgoing>SP_CHECK_if_3</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="iST2" name="Начислить очки по ScoringRule (0 — при неудаче)">
        <bpmn:incoming>SP_CHECK_if_2</bpmn:incoming>
        <bpmn:outgoing>SP_CHECK_if_4</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="iE" name="Ход учтён">
        <bpmn:incoming>SP_CHECK_if_4</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="iE_ERR" name="Ход отклонён">
        <bpmn:incoming>SP_CHECK_if_3</bpmn:incoming>
      <bpmn:errorEventDefinition id="erd_iE_ERR"/>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SP_CHECK_if_0" sourceRef="iS" targetRef="iST"/>
      <bpmn:sequenceFlow id="SP_CHECK_if_1" sourceRef="iST" targetRef="iG"/>
      <bpmn:sequenceFlow id="SP_CHECK_if_2" name="Да" sourceRef="iG" targetRef="iST2"/>
      <bpmn:sequenceFlow id="SP_CHECK_if_3" name="Нет" sourceRef="iG" targetRef="iE_ERR"/>
      <bpmn:sequenceFlow id="SP_CHECK_if_4" sourceRef="iST2" targetRef="iE"/>
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="B_ERR" name="Ход отклонён" attachedToRef="SP_CHECK" cancelActivity="true">
      <bpmn:outgoing>flow_9</bpmn:outgoing>
      <bpmn:errorEventDefinition id="erd_B_ERR"/>
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="G_mv" name="Ходы всех участников зафиксированы?">
      <bpmn:incoming>flow_13</bpmn:incoming>
      <bpmn:outgoing>flow_14</bpmn:outgoing>
      <bpmn:outgoing>flow_15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ST6" name="Определить результат раунда">
      <bpmn:incoming>flow_15</bpmn:incoming>
      <bpmn:outgoing>flow_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G5" name="Нужен ещё раунд?">
      <bpmn:incoming>flow_16</bpmn:incoming>
      <bpmn:outgoing>flow_17</bpmn:outgoing>
      <bpmn:outgoing>flow_18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ST7" name="Рассчитать результат сессии">
      <bpmn:incoming>flow_18</bpmn:incoming>
      <bpmn:outgoing>flow_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G6" name="Победитель однозначен?">
      <bpmn:incoming>flow_19</bpmn:incoming>
      <bpmn:outgoing>flow_20</bpmn:outgoing>
      <bpmn:outgoing>flow_22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="J5" name="">
      <bpmn:incoming>flow_21</bpmn:incoming>
      <bpmn:incoming>flow_22</bpmn:incoming>
      <bpmn:outgoing>flow_23</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ST8" name="Зафиксировать победителя и завершить сессию">
      <bpmn:incoming>flow_23</bpmn:incoming>
      <bpmn:outgoing>flow_24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ST9" name="Сформировать основание GAME для промокода">
      <bpmn:incoming>flow_24</bpmn:incoming>
      <bpmn:outgoing>flow_25</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E1" name="Победитель определён, основание GAME создано">
      <bpmn:incoming>flow_25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_0" sourceRef="S1" targetRef="T1"/>
    <bpmn:sequenceFlow id="flow_1" sourceRef="T1" targetRef="J1"/>
