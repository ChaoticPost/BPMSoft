<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ProfIT_BPMN_02" targetNamespace="http://bpmn.io/schema/bpmn" exporter="ProfIT BPMN build" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_ProfIT_BPMN_02">
    <bpmn:participant id="Pool_ProfIT_BPMN_02" name="ProfIT — формирование и публикация версии онлайн-теста (BPMN-02)" processRef="Process_ProfIT_BPMN_02" />
    <bpmn:participant id="PUB" name="Публичный пользователь (Web/Mobile)" />
    <bpmn:messageFlow id="msg_0" name="Опубликованные вопросы" sourceRef="SND1" targetRef="PUB" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ProfIT_BPMN_02" name="ProfIT — формирование и публикация версии онлайн-теста (BPMN-02)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ProfIT_BPMN_02">
      <bpmn:lane id="lane_emp" name="Сотрудник ProfIT">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_sys" name="Платформа BPMSoft">
        <bpmn:flowNodeRef>SP_EDIT</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SND1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Начата подготовка новой версии теста">
      <bpmn:outgoing>flow_0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="E2" name="Отказано в доступе">
      <bpmn:incoming>flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T1" name="Создать черновик TestVersion (DRAFT)">
      <bpmn:incoming>flow_3</bpmn:incoming>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:subProcess id="SP_EDIT" name="Наполнение и проверка версии">
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
      <bpmn:startEvent id="iS" name="Черновик создан">
        <bpmn:outgoing>SP_EDIT_if_0</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="iJ1">
        <bpmn:incoming>SP_EDIT_if_0</bpmn:incoming>
        <bpmn:incoming>SP_EDIT_if_6</bpmn:incoming>
        <bpmn:outgoing>SP_EDIT_if_1</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="iT2" name="Настроить вопросы, варианты, порог, группу">
        <bpmn:incoming>SP_EDIT_if_1</bpmn:incoming>
        <bpmn:outgoing>SP_EDIT_if_2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="iST" name="Проверить полноту и корректность версии">
        <bpmn:incoming>SP_EDIT_if_2</bpmn:incoming>
        <bpmn:outgoing>SP_EDIT_if_3</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="iG" name="Версия полна?">
        <bpmn:incoming>SP_EDIT_if_3</bpmn:incoming>
        <bpmn:outgoing>SP_EDIT_if_4</bpmn:outgoing>
        <bpmn:outgoing>SP_EDIT_if_5</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="iT3" name="Исправить черновик">
        <bpmn:incoming>SP_EDIT_if_5</bpmn:incoming>
        <bpmn:outgoing>SP_EDIT_if_6</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="iE" name="Версия готова">
        <bpmn:incoming>SP_EDIT_if_4</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SP_EDIT_if_0" sourceRef="iS" targetRef="iJ1" />
      <bpmn:sequenceFlow id="SP_EDIT_if_1" sourceRef="iJ1" targetRef="iT2" />
      <bpmn:sequenceFlow id="SP_EDIT_if_2" sourceRef="iT2" targetRef="iST" />
      <bpmn:sequenceFlow id="SP_EDIT_if_3" sourceRef="iST" targetRef="iG" />
      <bpmn:sequenceFlow id="SP_EDIT_if_4" name="Да" sourceRef="iG" targetRef="iE" />
      <bpmn:sequenceFlow id="SP_EDIT_if_5" name="Нет" sourceRef="iG" targetRef="iT3" />
      <bpmn:sequenceFlow id="SP_EDIT_if_6" sourceRef="iT3" targetRef="iJ1" />
    </bpmn:subProcess>
    <bpmn:serviceTask id="ST0" name="Проверить право TEST_MANAGE">
      <bpmn:incoming>flow_0</bpmn:incoming>
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G1" name="Право есть?">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ST2" name="Опубликовать версию (PUBLISHED)">
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="SND1" name="Предоставить вопросы каналам Web/Mobile">
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:outgoing>flow_7</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="E1" name="Версия опубликована">
      <bpmn:incoming>flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flow_0" sourceRef="S1" targetRef="ST0" />
    <bpmn:sequenceFlow id="flow_1" sourceRef="ST0" targetRef="G1" />
    <bpmn:sequenceFlow id="flow_2" name="Нет" sourceRef="G1" targetRef="E2" />
    <bpmn:sequenceFlow id="flow_3" name="Да" sourceRef="G1" targetRef="T1" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="T1" targetRef="SP_EDIT" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="SP_EDIT" targetRef="ST2" />
    <bpmn:sequenceFlow id="flow_6" sourceRef="ST2" targetRef="SND1" />
    <bpmn:sequenceFlow id="flow_7" sourceRef="SND1" targetRef="E1" />
  </bpmn:process>
