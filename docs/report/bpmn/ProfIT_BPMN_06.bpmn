<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ProfIT_BPMN_06" targetNamespace="http://bpmn.io/schema/bpmn" exporter="ProfIT BPMN build" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_ProfIT_BPMN_06">
    <bpmn:participant id="Pool_ProfIT_BPMN_06" name="ProfIT — проверка промокода и подтверждение покупки (BPMN-06)" processRef="Process_ProfIT_BPMN_06"/>
    <bpmn:participant id="TS" name="Внешняя торговая система"/>
    <bpmn:participant id="BUY" name="Покупатель"/>
    <bpmn:messageFlow id="msg_0" name="Запрос проверки" sourceRef="TS" targetRef="S1"/>
    <bpmn:messageFlow id="msg_1" name="401 / 403" sourceRef="SND_ERR" targetRef="TS"/>
    <bpmn:messageFlow id="msg_2" name="Отказ и причина" sourceRef="SND2" targetRef="TS"/>
    <bpmn:messageFlow id="msg_3" name="Скидка по позициям" sourceRef="SND3" targetRef="TS"/>
    <bpmn:messageFlow id="msg_4" name="Подтверждение покупки" sourceRef="TS" targetRef="iBUY"/>
    <bpmn:messageFlow id="msg_5" name="Отмена" sourceRef="TS" targetRef="B_C"/>
    <bpmn:messageFlow id="msg_6" name="Причина отказа" sourceRef="SND4" targetRef="TS"/>
    <bpmn:messageFlow id="msg_7" name="Подтверждение учёта" sourceRef="SND5" targetRef="TS"/>
    <bpmn:messageFlow id="msg_8" name="Заказ с промокодом" sourceRef="BUY" targetRef="TS"/>
    <bpmn:messageFlow id="msg_9" name="Итог со скидкой" sourceRef="TS" targetRef="BUY"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_ProfIT_BPMN_06" name="ProfIT — проверка промокода и подтверждение покупки (BPMN-06)" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ProfIT_BPMN_06">
      <bpmn:lane id="lane_api" name="Интеграционный API BPMSoft">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SND_ERR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_ERR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SND3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SND4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_REJ2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SND5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SND2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_REJ</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>J_AB</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_AB</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_sys" name="Ядро BPMSoft">
        <bpmn:flowNodeRef>ST1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ST2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SP_CONFIRM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_T</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_C</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B_ERR</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Запрос проверки корзины с промокодом">
      <bpmn:outgoing>flow_0</bpmn:outgoing>
      <bpmn:messageEventDefinition id="med_S1"/>
    </bpmn:startEvent>
    <bpmn:sendTask id="SND_ERR" name="Вернуть 401 / 403">
      <bpmn:incoming>flow_2</bpmn:incoming>
      <bpmn:outgoing>flow_3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="E_ERR" name="Отказано в доступе">
      <bpmn:incoming>flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="SND3" name="Вернуть расчёт скидки по позициям">
      <bpmn:incoming>flow_8</bpmn:incoming>
      <bpmn:outgoing>flow_9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="SND4" name="Вернуть причину отказа">
      <bpmn:incoming>flow_15</bpmn:incoming>
      <bpmn:outgoing>flow_16</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="E_REJ2" name="Покупка отклонена">
      <bpmn:incoming>flow_16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="SND5" name="Подтвердить учёт покупки">
      <bpmn:incoming>flow_10</bpmn:incoming>
      <bpmn:outgoing>flow_11</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="E1" name="Покупка учтена, код активирован">
      <bpmn:incoming>flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="SND2" name="Вернуть отказ с причиной">
      <bpmn:incoming>flow_6</bpmn:incoming>
      <bpmn:outgoing>flow_7</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="E_REJ" name="Проверка завершена отказом">
      <bpmn:incoming>flow_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="J_AB" name="">
      <bpmn:incoming>flow_12</bpmn:incoming>
      <bpmn:incoming>flow_13</bpmn:incoming>
      <bpmn:outgoing>flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_AB" name="Покупка не подтверждена">
      <bpmn:incoming>flow_14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ST1" name="Проверить машинную аутентификацию (X-API-Key)">
      <bpmn:incoming>flow_0</bpmn:incoming>
      <bpmn:outgoing>flow_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G1" name="Аутентификация успешна?">
      <bpmn:incoming>flow_1</bpmn:incoming>
      <bpmn:outgoing>flow_2</bpmn:outgoing>
      <bpmn:outgoing>flow_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ST2" name="Проверить код, статус, срок, группу, корзину">
      <bpmn:incoming>flow_4</bpmn:incoming>
      <bpmn:outgoing>flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G2" name="Промокод применим?">
      <bpmn:incoming>flow_5</bpmn:incoming>
      <bpmn:outgoing>flow_6</bpmn:outgoing>
      <bpmn:outgoing>flow_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="SP_CONFIRM" name="Обработка подтверждения покупки">
      <bpmn:incoming>flow_9</bpmn:incoming>
      <bpmn:outgoing>flow_10</bpmn:outgoing>
      <bpmn:startEvent id="iS" name="Скидка выдана">
        <bpmn:outgoing>SP_CONFIRM_if_0</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:eventBasedGateway id="iGEV" name="Исход оформления">
        <bpmn:incoming>SP_CONFIRM_if_0</bpmn:incoming>
        <bpmn:outgoing>SP_CONFIRM_if_1</bpmn:outgoing>
      </bpmn:eventBasedGateway>
      <bpmn:intermediateCatchEvent id="iBUY" name="Подтверждение покупки (orderId)">
        <bpmn:incoming>SP_CONFIRM_if_1</bpmn:incoming>
        <bpmn:outgoing>SP_CONFIRM_if_2</bpmn:outgoing>
      <bpmn:messageEventDefinition id="med_iBUY"/>
      </bpmn:intermediateCatchEvent>
      <bpmn:serviceTask id="iST3" name="Проверить идемпотентность orderId и повторить проверку">
        <bpmn:incoming>SP_CONFIRM_if_2</bpmn:incoming>
        <bpmn:outgoing>SP_CONFIRM_if_3</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="iG3" name="Покупка допустима и не дубль?">
        <bpmn:incoming>SP_CONFIRM_if_3</bpmn:incoming>
        <bpmn:outgoing>SP_CONFIRM_if_4</bpmn:outgoing>
        <bpmn:outgoing>SP_CONFIRM_if_5</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="iST4" name="Сохранить Purchase и скидки атомарно">
        <bpmn:incoming>SP_CONFIRM_if_4</bpmn:incoming>
        <bpmn:outgoing>SP_CONFIRM_if_6</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="iST5" name="Активировать код → ACTIVATED">
        <bpmn:incoming>SP_CONFIRM_if_6</bpmn:incoming>
        <bpmn:outgoing>SP_CONFIRM_if_7</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="iE_OK" name="Покупка учтена">
        <bpmn:incoming>SP_CONFIRM_if_7</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:endEvent id="iE_ERR" name="Покупка отклонена">
        <bpmn:incoming>SP_CONFIRM_if_5</bpmn:incoming>
      <bpmn:errorEventDefinition id="erd_iE_ERR"/>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SP_CONFIRM_if_0" sourceRef="iS" targetRef="iGEV"/>
      <bpmn:sequenceFlow id="SP_CONFIRM_if_1" sourceRef="iGEV" targetRef="iBUY"/>
      <bpmn:sequenceFlow id="SP_CONFIRM_if_2" sourceRef="iBUY" targetRef="iST3"/>
      <bpmn:sequenceFlow id="SP_CONFIRM_if_3" sourceRef="iST3" targetRef="iG3"/>
      <bpmn:sequenceFlow id="SP_CONFIRM_if_4" name="Да" sourceRef="iG3" targetRef="iST4"/>
      <bpmn:sequenceFlow id="SP_CONFIRM_if_5" name="Нет" sourceRef="iG3" targetRef="iE_ERR"/>
      <bpmn:sequenceFlow id="SP_CONFIRM_if_6" sourceRef="iST4" targetRef="iST5"/>
      <bpmn:sequenceFlow id="SP_CONFIRM_if_7" sourceRef="iST5" targetRef="iE_OK"/>
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="B_T" name="Таймаут ожидания" attachedToRef="SP_CONFIRM" cancelActivity="true">
      <bpmn:outgoing>flow_12</bpmn:outgoing>
      <bpmn:timerEventDefinition id="ted_B_T"/>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="B_C" name="Отмена оформления" attachedToRef="SP_CONFIRM" cancelActivity="true">
      <bpmn:outgoing>flow_13</bpmn:outgoing>
      <bpmn:messageEventDefinition id="med_B_C"/>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="B_ERR" name="Покупка отклонена" attachedToRef="SP_CONFIRM" cancelActivity="true">
      <bpmn:outgoing>flow_15</bpmn:outgoing>
      <bpmn:errorEventDefinition id="erd_B_ERR"/>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="flow_0" sourceRef="S1" targetRef="ST1"/>
    <bpmn:sequenceFlow id="flow_1" sourceRef="ST1" targetRef="G1"/>
    <bpmn:sequenceFlow id="flow_2" name="Нет" sourceRef="G1" targetRef="SND_ERR"/>
    <bpmn:sequenceFlow id="flow_3" sourceRef="SND_ERR" targetRef="E_ERR"/>
    <bpmn:sequenceFlow id="flow_4" name="Да" sourceRef="G1" targetRef="ST2"/>
    <bpmn:sequenceFlow id="flow_5" sourceRef="ST2" targetRef="G2"/>
    <bpmn:sequenceFlow id="flow_6" name="Нет" sourceRef="G2" targetRef="SND2"/>
    <bpmn:sequenceFlow id="flow_7" sourceRef="SND2" targetRef="E_REJ"/>
    <bpmn:sequenceFlow id="flow_8" name="Да" sourceRef="G2" targetRef="SND3"/>
    <bpmn:sequenceFlow id="flow_9" sourceRef="SND3" targetRef="SP_CONFIRM"/>
    <bpmn:sequenceFlow id="flow_10" sourceRef="SP_CONFIRM" targetRef="SND5"/>
    <bpmn:sequenceFlow id="flow_11" sourceRef="SND5" targetRef="E1"/>
    <bpmn:sequenceFlow id="flow_12" sourceRef="B_T" targetRef="J_AB"/>
    <bpmn:sequenceFlow id="flow_13" sourceRef="B_C" targetRef="J_AB"/>
    <bpmn:sequenceFlow id="flow_14" sourceRef="J_AB" targetRef="E_AB"/>
    <bpmn:sequenceFlow id="flow_15" sourceRef="B_ERR" targetRef="SND4"/>
    <bpmn:sequenceFlow id="flow_16" sourceRef="SND4" targetRef="E_REJ2"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDI_ProfIT_BPMN_06">
    <bpmndi:BPMNPlane id="BPMNPlane_ProfIT_BPMN_06" bpmnElement="Collab_ProfIT_BPMN_06">
      <bpmndi:BPMNShape id="Pool_ProfIT_BPMN_06_di" bpmnElement="Pool_ProfIT_BPMN_06" isHorizontal="true"><dc:Bounds x="60" y="60" width="3047" height="750"/></bpmndi:BPMNShape>
