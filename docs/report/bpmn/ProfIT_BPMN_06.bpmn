        <bpmndi:BPMNLabel><dc:Bounds x="1946" y="822" width="119" height="30"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="flow_0_di" bpmnElement="flow_0">
        <di:waypoint x="190" y="153"/>
        <di:waypoint x="190" y="349"/>
        <di:waypoint x="365" y="349"/>
        <di:waypoint x="365" y="545"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_1_di" bpmnElement="flow_1">
        <di:waypoint x="415" y="585"/>
        <di:waypoint x="515" y="585"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="flow_2_di" bpmnElement="flow_2">
        <di:waypoint x="540" y="560"/>
        <di:waypoint x="540" y="375"/>
        <di:waypoint x="715" y="375"/>
        <di:waypoint x="715" y="175"/>
        <bpmndi:BPMNLabel><dc:Bounds x="514" y="462" width="80" height="14"/></bpmndi:BPMNLabel>
